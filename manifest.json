{
  "manifest_version": 3,
  "name": "Universal Video Double-Tap Seek",
  "version": "2.0",
  "description": "Double-tap to seek on any embedded video player (JWPlayer, EV-Player, iframes).",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
