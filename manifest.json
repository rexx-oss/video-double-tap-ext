{
  "manifest_version": 3,
  "name": "Video Double-Tap Seek",
  "version": "1.0",
  "description": "Double-tap left or right to rewind/fast-forward any video like on iOS.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}